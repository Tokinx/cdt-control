# 面板登录账号（默认 admin）
PANEL_USERNAME=admin

# 面板登录密码（必填）
PANEL_PASSWORD=change_me_strong_password

# 对外映射端口（默认 8080）
PANEL_PORT=8080

# 时区（影响定时开关机窗口，默认 Asia/Shanghai）
TZ=Asia/Shanghai

# 默认巡检间隔秒数（默认 60）
CHECK_INTERVAL=60

# 若挂在 HTTPS 反向代理后建议设为 true
COOKIE_SECURE=false

# 可选：自定义签名及敏感凭证加密主密钥（不填会自动生成并持久化至 /app/data/.session_secret）
# SESSION_SECRET=
